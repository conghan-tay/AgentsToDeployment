# Public edge API
# Local defaults are convenient for development. Production startup rejects them.
API_KEY=local-api-key
GATEWAY_PORT=8080

# Temporal. The local stack runs a dev server; production points at a real cluster or
# Temporal Cloud (set TEMPORAL_API_KEY and TEMPORAL_TLS=true).
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=support-agent
TEMPORAL_API_KEY=
TEMPORAL_TLS=false

# Model selection: openai (default), anthropic, google, or fake (tests/demo only)
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5-mini
# MODEL_TEMPERATURE=0.2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# LangSmith is optional. Set LANGSMITH_TRACING=true to enable it.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=support-agent-template

# Infrastructure
REDIS_URL=redis://redis:6379/0
# The gateway writes knowledge over HTTP; the worker reads it with the Chroma client.
CHROMA_URL=http://chroma:8000
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_COLLECTION=support_knowledge
# Shared by both services. OPENAI_API_KEY is required for embeddings even when the chat
# provider is not OpenAI.
EMBEDDING_MODEL=text-embedding-3-small
MCP_SERVER_URL=http://mcp-tools:8001/mcp

# Safety and workflow controls
MAX_INPUT_CHARS=8000
MAX_REFLECTION_LOOPS=1
REQUIRE_APPROVAL_FOR=refund,account_credit,cancel_order
# How long a ticket waits for a reviewer before auto-rejecting. 0 waits forever.
# Owned by the gateway: workflow code cannot read the environment.
APPROVAL_TIMEOUT_HOURS=72
RATE_LIMIT_PER_MINUTE=60
