# Public edge API
# Local defaults are convenient for development. Production startup rejects them.
API_KEY=local-api-key
INTERNAL_API_KEY=local-internal-key
GATEWAY_PORT=8080
AGENT_SERVICE_URL=http://agent:8000

# Model selection: openai (default), anthropic, google, or fake (tests/demo only)
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5-mini
# MODEL_TEMPERATURE=0.2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# LangSmith is optional. Set LANGSMITH_TRACING=true to enable it.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=support-agent-template

# Infrastructure
POSTGRES_DSN=postgresql://support:support@postgres:5432/support?sslmode=disable
REDIS_URL=redis://redis:6379/0
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_COLLECTION=support_knowledge
MCP_SERVER_URL=http://mcp-tools:8001/mcp
CHECKPOINTER_BACKEND=postgres
KNOWLEDGE_BACKEND=chroma

# Safety and workflow controls
MAX_INPUT_CHARS=8000
MAX_REFLECTION_LOOPS=1
REQUIRE_APPROVAL_FOR=refund,account_credit,cancel_order
ALLOWED_ORIGINS=http://localhost:3000
